# Copy this file to .env and fill in real values. Never commit .env itself.

# --- IBKR / IB Gateway ---
IBKR_HOST=127.0.0.1
IBKR_PORT=4002          # 4002 = paper trading, 4001 = live trading (IB Gateway defaults)
IBKR_CLIENT_ID=1
IBKR_ACCOUNT_ID=        # e.g. DU1234567 for paper, U1234567 for live

# --- Trading mode ---
# Must be explicitly set to "live" to enable real orders. Defaults to paper trading.
TRADING_MODE=paper

# --- Telegram alerting ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Risk limits (Phase 3) ---
MAX_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_CONCURRENT_POSITIONS=5
